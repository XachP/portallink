    "status": "node status.mjs",
    "test": "node --test test/"
  },
  "dependencies": {
    "@polkadot/api": "^16.5.6",
    "@polkadot/keyring": "^14.0.3",
    "@polkadot/util-crypto": "^14.0.3",
    "ethers": "6.13.4"
  },
  "engines": {
    "node": ">=20"
  }
