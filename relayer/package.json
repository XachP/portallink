{
  "name": "portallink-relayer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PortalLink attesters + relayer: watches PortalGateway events on every chain and delivers 2-of-3 attested transfers.",
  "license": "MIT",
  "scripts": {
    "deploy": "node deploy.mjs",
    "relay": "node relayer.mjs",
